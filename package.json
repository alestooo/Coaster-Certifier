{
  "name": "coaster-certifier",
  "version": "0.9.0",
  "description": "Certificador de montañas rusas: simulador web con librería de física propia, pruebas de validación analítica, dictamen de aprobación y ejecución headless. Proyecto de Física I (FUN-18), Universidad CENFOTEC.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "headless": "node scripts/headless.js",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alestooo/Coaster-Certifier.git"
  },
  "keywords": [
    "physics",
    "simulation",
    "roller-coaster",
    "svelte",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/alestooo/Coaster-Certifier/issues"
  },
  "homepage": "https://github.com/alestooo/Coaster-Certifier#readme",
  "dependencies": {
    "chart.js": "^4.5.1",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=18.17"
  }
}
